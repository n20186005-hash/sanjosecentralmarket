---
import '../styles/global.css';
import { localizedPath, hreflangAlternates, t, type Locale } from '../i18n';
interface Props {
  title: string;
  description: string;
  locale?: Locale;
  path?: string; // base path without locale prefix and without trailing slash ('' = home)
  image?: string;
}
const {
  title,
  description,
  locale = 'es',
  path = '',
  image = '/images/mercado-central-san-jose-fachada.jpg'
} = Astro.props;
const site = Astro.site;
const U = t(locale);
const canonical = site ? new URL(localizedPath(path, locale), site).toString() : undefined;
const ogImage = site ? new URL(image, site).toString() : undefined;
const logoUrl = site ? new URL('/icons/logo.svg', site).toString() : undefined;
const alternates = site ? hreflangAlternates(path, site) : [];
const ogImageAlt = locale === 'en' ? 'Central Market of San José – San José, Costa Rica' : 'Mercado Central de San José – San José, Costa Rica';

const navHref = (anchor: string) => (path === '' ? '#' + anchor : localizedPath('', locale) + '#' + anchor);
const otherLocale: Locale = locale === 'es' ? 'en' : 'es';
const switchHref = localizedPath(path, otherLocale);

const orgSchema = site ? {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': site.toString() + '#website', url: site.toString(), name: U.siteName, inLanguage: U.htmlLang, publisher: { '@id': site.toString() + '#organization' } },
    { '@type': 'Organization', '@id': site.toString() + '#organization', name: U.siteName, url: site.toString(), logo: logoUrl ? { '@type': 'ImageObject', url: logoUrl } : undefined }
  ]
} : null;
const webPageSchema = site && canonical ? {
  '@context': 'https://schema.org', '@type': 'WebPage', '@id': canonical + '#webpage', url: canonical, name: title, description, inLanguage: U.htmlLang, isPartOf: { '@id': site.toString() + '#website' }, dateModified: '2026-09-02'
} : null;
---
<!doctype html>
<html lang={U.htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#9f3428" />
  <title>{title}</title>
  {canonical && <link rel="canonical" href={canonical} />}
  {alternates.map((a) => <link rel="alternate" hreflang={a.hreflang} href={a.href} />)}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content={U.ogLocale} />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  {ogImage && <meta property="og:image:alt" content={ogImageAlt} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
  <link rel="manifest" href="/manifest.webmanifest" />
  {orgSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(orgSchema)}></script>}
  {webPageSchema && <script type="application/ld+json" is:inline set:html={JSON.stringify(webPageSchema)}></script>}
</head>
<body>
<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href={localizedPath('', locale)}><img src="/icons/logo.svg" alt="Logo Guía Mercado Central" /><span>Mercado Central<br/><small>San José</small></span></a>
    <nav class="nav-links" aria-label="Navegación principal">
      <a href={navHref('historia')}>{U.nav.historia}</a><a href={navHref('historias')}>{U.nav.historias}</a><a href={navHref('visita')}>{U.nav.visita}</a><a href={navHref('comer')}>{U.nav.comer}</a><a href={navHref('servicios')}>{U.nav.servicios}</a><a href={navHref('llegar')}>{U.nav.llegar}</a><a href={navHref('faq')}>{U.nav.faq}</a>
      <a class="lang-switch" href={switchHref} hreflang={otherLocale} aria-label={U.langSwitch.label}>{U.langSwitch.to}</a>
    </nav>
  </div>
</header>
<main><slot /></main>
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <img src="/icons/logo.svg" alt="" width="54" height="54" />
      <p><strong>{U.siteName}</strong></p>
      <p>{U.footer.disclaimer1}</p>
      <p>{U.footer.disclaimer2}</p>
      <p>{U.footer.imageRightsPrefix}<a href={localizedPath('creditos-fotograficos', locale)}>{U.footer.imageRightsPage}</a>{U.footer.imageRightsSuffix}</p>
    </div>
    <div>
      <div class="legal-links">
        <a href={localizedPath('privacidad', locale)}>{U.footer.legalLinks.privacidad}</a>
        <a href={localizedPath('terminos', locale)}>{U.footer.legalLinks.terminos}</a>
        <a href={localizedPath('configuracion-de-cookies', locale)}>{U.footer.legalLinks.cookies}</a>
      </div>
      <p style="margin-top:26px">{U.footer.copyright}</p>
      <p>{U.footer.nonofficial}</p>
    </div>
  </div>
</footer>
<script is:inline>
(function(){
  const key='mc-sj-cookie-preferences';
  function loadGA(){
    if(document.getElementById('ga4-loader')) return;
    const s=document.createElement('script'); s.id='ga4-loader'; s.async=true; s.src='https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP'; document.head.appendChild(s);
    window.dataLayer=window.dataLayer||[]; function gtag(){window.dataLayer.push(arguments)} window.gtag=gtag; gtag('js',new Date()); gtag('config','G-HXM22WWPKP',{anonymize_ip:true});
  }
  try{const p=JSON.parse(localStorage.getItem(key)||'{}'); if(p.analytics===true) loadGA();}catch(e){}
  window.__mcLoadGA=loadGA;
})();
</script>
<script is:inline>
if('serviceWorker' in navigator){ window.addEventListener('load',function(){ navigator.serviceWorker.register('/sw.js').catch(function(){}); }); }
</script>
</body>
</html>
