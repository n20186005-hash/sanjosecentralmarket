---
import '../styles/global.css';
interface Props { title: string; description: string; image?: string; }
const { title, description, image='/images/mercado-central-san-jose-fachada.jpg' } = Astro.props;
const site = Astro.site;
const canonical = site ? new URL(Astro.url.pathname, site).toString() : undefined;
const ogImage = site ? new URL(image, site).toString() : undefined;
---
<!doctype html>
<html lang="es-CR">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width" />
  <meta name="description" content={description} />
  <meta name="theme-color" content="#9f3428" />
  <title>{title}</title>
  {canonical && <link rel="canonical" href={canonical} />}
  <meta property="og:type" content="website" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:locale" content="es_CR" />
  {canonical && <meta property="og:url" content={canonical} />}
  {ogImage && <meta property="og:image" content={ogImage} />}
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/icons/favicon.svg" />
  <link rel="icon" type="image/png" sizes="32x32" href="/icons/favicon-32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/icons/favicon-16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/icons/apple-touch-icon.png" />
</head>
<body>
<header class="site-header">
  <div class="wrap nav">
    <a class="brand" href="/"><img src="/icons/logo.svg" alt="Logo Guía Mercado Central" /><span>Mercado Central<br/><small>San José</small></span></a>
    <nav class="nav-links" aria-label="Navegación principal">
      <a href="/#historia">Historia</a><a href="/#visita">Planifique</a><a href="/#comer">Dónde comer</a><a href="/#llegar">Cómo llegar</a><a href="/#faq">FAQ</a>
    </nav>
  </div>
</header>
<main><slot /></main>
<footer class="site-footer">
  <div class="wrap footer-grid">
    <div>
      <img src="/icons/logo.svg" alt="" width="54" height="54" />
      <p><strong>Guía del Mercado Central de San José</strong></p>
      <p>Este sitio es un proyecto independiente y sin fines de lucro de información para visitantes; no mantiene relación de dependencia con la Municipalidad de San José, el Instituto Costarricense de Turismo ni ninguna organización oficial.</p>
      <p>La información del sitio se contrasta con fuentes públicas de la Municipalidad de San José, el Ministerio de Cultura y Juventud de Costa Rica y el Instituto Costarricense de Turismo. No contiene recomendaciones comerciales pagadas.</p>
      <p>Derechos de imagen: las fotografías pertenecen a sus autores originales y se utilizan conforme a las licencias indicadas en <a href="/creditos-fotograficos/">créditos fotográficos</a>.</p>
    </div>
    <div>
      <div class="legal-links"><a href="/privacidad/">Privacidad</a><a href="/terminos/">Términos</a><a href="/configuracion-de-cookies/">Configurar cookies</a></div>
      <p style="margin-top:26px">© 2026 Guía del Mercado Central de San José. Todos los derechos reservados sobre el diseño y contenido original.</p>
      <p>Guía no oficial. Verifique horarios y condiciones con fuentes oficiales antes de desplazarse.</p>
    </div>
  </div>
</footer>
<script is:inline>
(function(){
  const key='mc-sj-cookie-preferences';
  function loadGA(){
    if(document.getElementById('ga4-loader')) return;
    const s=document.createElement('script'); s.id='ga4-loader'; s.async=true; s.src='https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP'; document.head.appendChild(s);
    window.dataLayer=window.dataLayer||[]; function gtag(){window.dataLayer.push(arguments)} window.gtag=gtag; gtag('js',new Date()); gtag('config','G-HXM22WWPKP',{anonymize_ip:true});
  }
  try{const p=JSON.parse(localStorage.getItem(key)||'{}'); if(p.analytics===true) loadGA();}catch(e){}
  window.__mcLoadGA=loadGA;
})();
</script>
</body>
</html>
